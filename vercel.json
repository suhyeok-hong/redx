{
  "rewrites": [
    { "source": "/:code/manifest.json", "destination": "/api/[code]?code=:code" },
    { "source": "/:code/manifest_kaya.json", "destination": "/api/[code]?code=:code" },
    { "source": "/:code/sw.js", "destination": "/api/[code]?code=:code" },
    { "source": "/:code", "destination": "/api/[code]?code=:code" },
    { "source": "/:code/", "destination": "/api/[code]?code=:code" },
    { "source": "/:code/:path*", "destination": "/api/[code]?code=:code" }
  ]
}
